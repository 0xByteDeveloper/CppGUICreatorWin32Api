// app.rc — version info (manifest is embedded by the linker via app.manifest)
#include <windows.h>

#define VER_FILEVERSION             1,0,0,0
#define VER_PRODUCTVERSION          1,0,0,0
#define VER_FILEVERSION_STR         "1.0.0.0\0"
#define VER_PRODUCTVERSION_STR      "1.0.0.0\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "0xByteDeveloper"
            VALUE "FileDescription",  "CppGUI Creator - Pure Win32 API GUI Designer"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "CppGUICreatorWin32Api"
            VALUE "ProductName",      "CppGUICreatorWin32Api"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "OriginalFilename", "CppGUICreatorWin32Api.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
